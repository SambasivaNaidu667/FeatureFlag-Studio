PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/featureflag_studio?retryWrites=true&w=majority
# Initial administrator bootstrap configuration (used by `npm run bootstrap-admin`):
ADMIN_EMAIL=admin@featureflag.local
ADMIN_NAME=Studio Admin
ADMIN_USERNAME=admin
# Easiest: run `npm run set-admin-password` (prompts, hides input, writes the hash here),
# then `npm run bootstrap-admin -- --apply` (or with `--reset-password --confirm-reset`).
# Generate with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "replace-with-a-strong-password"
ADMIN_PASSWORD_HASH=<bcrypt-hash>
JWT_SECRET=<at-least-32-random-characters>
JWT_EXPIRES_IN=15m
ALLOW_PUBLIC_REGISTRATION=false
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
EVALUATION_RATE_LIMIT_MAX=300
EVALUATION_RATE_LIMIT_WINDOW_MS=60000
# Reverse proxy configuration for client IP resolution and rate limiting.
# Defaults to false (disabled) so spoofed X-Forwarded-For headers are ignored when running directly.
# Set to a positive integer hop count (for example, 1 behind a single reverse proxy/load balancer)
# or a named subnet (loopback, linklocal, uniquelocal). Never set to "true" or "*".
TRUST_PROXY=false
# Optional workaround for environments with broken local SRV DNS resolution.
# MONGODB_DNS_SERVER=8.8.8.8
